# Copy this to .env and fill in your values

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/supplychain

# Port for the Node.js server
PORT=3000

# URL of the Java routing engine (RoutingHttpServer)
JAVA_BRIDGE_URL=http://localhost:8080

# Gemini API key for AI risk assessment (optional — routing works without it)
GEMINI_API_KEY=your_gemini_api_key_here
